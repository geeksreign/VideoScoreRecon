{
  "manifest_version": 3,
  "name": "视频乐谱提取器",
  "version": "0.1.0",
  "description": "从 B 站视频页面一键提取滚动曲谱并拼接为完整乐谱（需配合本地服务运行）",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://www.bilibili.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "视频乐谱提取器设置" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["content.js"],
      "css": ["panel.css"]
    }
  ]
}
