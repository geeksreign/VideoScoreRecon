{
  "manifest_version": 3,
  "name": "ScoreStitch",
  "version": "1.0.0",
  "description": "从 B 站视频页一键提取滚动乐谱并拼接为完整乐谱长图——全部处理在本机浏览器完成，不上传任何视频或 Cookie。",
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "*://*.bilivideo.com/*",
    "*://*.bilivideo.cn/*",
    "*://*.mountaintoys.cn/*",
    "*://*.akamaized.net/*",
    "*://*.hdslb.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "ScoreStitch 设置",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["src/b64.js", "src/acquire.js", "content.js"],
      "css": ["ui.css", "panel.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["worker_host.html", "src/worker.js", "icons/logo.png"],
      "matches": ["https://*.bilibili.com/*"]
    }
  ]
}
